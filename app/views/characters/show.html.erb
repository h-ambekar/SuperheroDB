<% provide(:title, @character.name) %>

<div class="container character-show mt-4">
  <div class="card shadow-lg p-4">
    
    <div class="row">
      <!-- Character Image -->
      <div class="col-md-4 text-center">
        <img src="<%= @character.image_url %>" class="character-image img-fluid rounded shadow" alt="<%= @character.name %>">
      </div>

      <!-- Character Details -->
      <div class="col-md-8">
        <h2 class="text-primary"><%= @character.name %></h2>
        <hr>
        <p><strong>Full Name:</strong> <%= @character.full_name.present? ? @character.full_name : "N/A" %></p>
        <p><strong>Publisher:</strong> <%= @character.publisher.present? ? @character.publisher : "Unknown" %></p>
        <p><strong>Alignment:</strong> <%= @character.alignment.present? ? @character.alignment.capitalize : "Unknown" %></p>
        <p><strong>First Appearance:</strong> <%= @character.first_appearance.present? ? @character.first_appearance : "N/A" %></p>
      </div>
    </div>
  </div>

  <!-- Related Media -->
  <div class="related-media mt-4">
    <div class="row">
      <div class="col-md-4">
        <h3 class="text-secondary">Films</h3>
        <ul class="list-group">
          <% if @character.films.any? %>
            <% @character.films.each do |film| %>
              <li class="list-group-item"><%= film.name %></li>
            <% end %>
          <% else %>
            <li class="list-group-item text-muted">No films available</li>
          <% end %>
        </ul>
      </div>

      <div class="col-md-4">
        <h3 class="text-secondary">TV Shows</h3>
        <ul class="list-group">
          <% if @character.tv_shows.any? %>
            <% @character.tv_shows.each do |show| %>
              <li class="list-group-item"><%= show.name %></li>
            <% end %>
          <% else %>
            <li class="list-group-item text-muted">No TV shows available</li>
          <% end %>
        </ul>
      </div>

      <div class="col-md-4">
        <h3 class="text-secondary">Video Games</h3>
        <ul class="list-group">
          <% if @character.video_games.any? %>
            <% @character.video_games.each do |game| %>
              <li class="list-group-item"><%= game.name %></li>
            <% end %>
          <% else %>
            <li class="list-group-item text-muted">No video games available</li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <!-- Back Button -->
  <div class="mt-4">
    <a href="<%= characters_path %>" class="btn btn-secondary">Back to Superheroes</a>
  </div>
</div>
<footer class="footer mt-5 py-3">
  <div class="container text-center">
    <div class="row">
      <!-- Footer Links -->
      <div class="col-md-6">
        <ul class="footer-links list-inline">
          <li class="list-inline-item"><a href="<%= root_path %>">Home</a></li>
          <li class="list-inline-item"><a href="<%= characters_path %>">Superheroes</a></li>
          <li class="list-inline-item"><a href="<%= about_path %>">About</a></li>
          <li class="list-inline-item"><a href="<%= users_path %>">Users</a></li>
        </ul>
      </div>

      <!-- Social Icons -->
      <div class="col-md-6">
        <ul class="social-icons list-inline">
          <li class="list-inline-item">
            <a href="https://github.com/" target="_blank"><i class="fab fa-github"></i></a>
          </li>
          <li class="list-inline-item">
            <a href="https://twitter.com/" target="_blank"><i class="fab fa-twitter"></i></a>
          </li>
          <li class="list-inline-item">
            <a href="https://linkedin.com/" target="_blank"><i class="fab fa-linkedin"></i></a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-3">&copy; <%= Time.current.year %> Superhero Database. All Rights Reserved.</p>
  </div>
</footer>
