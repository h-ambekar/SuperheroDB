<% provide(:title, @character.name) %>

<div class="container character-show mt-4">
  <div class="card shadow-lg p-4">
    
    <div class="row">
      <!-- Character Image -->
      <div class="col-md-4 text-center">
        <img src="<%= @character.image_url %>" class="character-image img-fluid rounded shadow" alt="<%= @character.name %>">
      </div>

      <!-- Character Details -->
      <div class="col-md-8">
        <h2 class="text-primary"><%= @character.name %></h2>
        <hr>
        <p><strong>Full Name:</strong> <%= @character.full_name.present? ? @character.full_name : "N/A" %></p>
        <p><strong>Publisher:</strong> <%= @character.publisher.present? ? @character.publisher : "Unknown" %></p>
        <p><strong>Alignment:</strong> <%= @character.alignment.present? ? @character.alignment.capitalize : "Unknown" %></p>
        <p><strong>First Appearance:</strong> <%= @character.first_appearance.present? ? @character.first_appearance : "N/A" %></p>
      </div>
    </div>
  </div>

  <!-- Related Media Section -->
  <div class="related-media mt-4">
    <div class="row">
      
      <!-- Films Section -->
      <div class="col-md-4">
        <h3 class="text-secondary"><i class="fas fa-film"></i> Films</h3>
        <div class="card media-card">
          <ul class="list-group list-group-flush">
            <% if @character.films.any? %>
              <% @character.films.each do |film| %>
                <li class="list-group-item">
                  <i class="fas fa-video text-primary"></i> <%= film.name %>
                </li>
              <% end %>
            <% else %>
              <li class="list-group-item text-muted">No films available</li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- TV Shows Section -->
      <div class="col-md-4">
        <h3 class="text-secondary"><i class="fas fa-tv"></i> TV Shows</h3>
        <div class="card media-card">
          <ul class="list-group list-group-flush">
            <% if @character.tv_shows.any? %>
              <% @character.tv_shows.each do |show| %>
                <li class="list-group-item">
                  <i class="fas fa-tv text-success"></i> <%= show.name %>
                </li>
              <% end %>
            <% else %>
              <li class="list-group-item text-muted">No TV shows available</li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- Video Games Section -->
      <div class="col-md-4">
        <h3 class="text-secondary"><i class="fas fa-gamepad"></i> Video Games</h3>
        <div class="card media-card">
          <ul class="list-group list-group-flush">
            <% if @character.video_games.any? %>
              <% @character.video_games.each do |game| %>
                <li class="list-group-item">
                  <i class="fas fa-gamepad text-danger"></i> <%= game.name %>
                </li>
              <% end %>
            <% else %>
              <li class="list-group-item text-muted">No video games available</li>
            <% end %>
          </ul>
        </div>
      </div>

    </div>
  </div>

  <!-- Back Button -->
  <div class="mt-4">
    <a href="<%= characters_path %>" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Superheroes</a>
  </div>
</div>
