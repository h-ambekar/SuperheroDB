<% provide(:title, "Superheroes") %>

<div class="container mt-4">
  <h1 class="text-center">Superhero Database</h1>

  <!-- Search & Filter -->
  <div class="search-container">
    <%= form_with url: characters_path, method: :get, local: true, class: "search-form d-flex align-items-center justify-content-center flex-wrap" do |form| %>
      <div class="search-input-group me-2">
        <%= form.text_field :search, placeholder: "Search Superheroes...", class: "form-control" %>
      </div>
      
      <div class="filter-input-group me-2">
        <%= form.select :publisher, options_for_select(["All"] + Character.distinct.pluck(:publisher)), {}, class: "form-control" %>
      </div>

      <div class="button-group">
        <%= form.submit "Search", class: "btn btn-primary me-2" %>
        <%= link_to "Reset", characters_path, class: "btn btn-danger" %>
      </div>
    <% end %>
  </div>

  <!-- Superhero Cards -->
  <div class="row mt-4">
    <% @characters.each do |character| %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <img src="<%= character.image_url.presence || 'default-image.jpg' %>" class="card-img-top character-image" alt="<%= character.name %>">
          <div class="card-body text-center">
            <h5 class="card-title"><%= character.name %></h5>
            <p class="card-text"><strong>Publisher:</strong> <%= character.publisher.presence || "Unknown" %></p>
            <a href="<%= character_path(character) %>" class="btn btn-primary">View Details</a>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="pagination-container text-center">
    <%= paginate @characters %>
  </div>
</div>
<footer class="footer mt-5 py-3">
  <div class="container text-center">
    <div class="row">
      <!-- Footer Links -->
      <div class="col-md-6">
        <ul class="footer-links list-inline">
          <li class="list-inline-item"><a href="<%= root_path %>">Home</a></li>
          <li class="list-inline-item"><a href="<%= characters_path %>">Superheroes</a></li>
          <li class="list-inline-item"><a href="<%= about_path %>">About</a></li>
          <li class="list-inline-item"><a href="<%= users_path %>">Users</a></li>
        </ul>
      </div>

      <!-- Social Icons -->
      <div class="col-md-6">
        <ul class="social-icons list-inline">
          <li class="list-inline-item">
            <a href="https://github.com/" target="_blank"><i class="fab fa-github"></i></a>
          </li>
          <li class="list-inline-item">
            <a href="https://twitter.com/" target="_blank"><i class="fab fa-twitter"></i></a>
          </li>
          <li class="list-inline-item">
            <a href="https://linkedin.com/" target="_blank"><i class="fab fa-linkedin"></i></a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-3">&copy; <%= Time.current.year %> Superhero Database. All Rights Reserved.</p>
  </div>
</footer>
