<% provide(:title, "Superheroes") %>

<div class="container mt-4">
  <h1 class="text-center">Superhero Database</h1>

  <!-- Search & Filter -->
  <div class="search-container">
    <%= form_with url: characters_path, method: :get, local: true, class: "search-form d-flex align-items-center justify-content-center flex-wrap" do |form| %>
      <div class="search-input-group me-2">
        <%= form.text_field :search, placeholder: "Search Superheroes...", class: "form-control" %>
      </div>
      
      <div class="filter-input-group me-2">
        <%= form.select :publisher, options_for_select(["All"] + Character.distinct.pluck(:publisher)), {}, class: "form-control" %>
      </div>

      <div class="button-group">
        <%= form.submit "Search", class: "btn btn-primary me-2" %>
        <%= link_to "Reset", characters_path, class: "btn btn-danger" %>
      </div>
    <% end %>
  </div>

  <!-- Superhero Cards -->
  <div class="row mt-4">
    <% @characters.each do |character| %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <img src="<%= character.image_url.presence || 'default-image.jpg' %>" class="card-img-top character-image" alt="<%= character.name %>">
          <div class="card-body text-center">
            <h5 class="card-title"><%= character.name %></h5>
            <p class="card-text"><strong>Publisher:</strong> <%= character.publisher.presence || "Unknown" %></p>
            <a href="<%= character_path(character) %>" class="btn btn-primary">View Details</a>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="pagination-container text-center">
    <%= paginate @characters %>
  </div>
</div>

